<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Aplicatvo_teste.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Aplicatvo_teste"
    Title="Aplicatvo_teste"
    Shell.NavBarHasShadow="True">

    <Shell.Resources>
        <Style TargetType="Shell" ApplyToDerivedTypes="True">
            <Setter Property="Shell.BackgroundColor" Value="#1E2A1C"/>
            <Setter Property="Shell.ForegroundColor" Value="#FAFAF7"/>
            <Setter Property="Shell.TitleColor" Value="#FAFAF7"/>
            <Setter Property="Shell.DisabledColor" Value="#B2FAFAF7"/>
            <Setter Property="Shell.UnselectedColor" Value="#95FAFAF7"/>
            <Setter Property="Shell.NavBarHasShadow" Value="True"/>
        </Style>
    </Shell.Resources>

    <ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />

</Shell>
