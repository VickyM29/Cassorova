<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplicatvo_teste.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Creme}">


    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- HERO SECTION -->
            <Grid HeightRequest="280" BackgroundColor="{StaticResource VerdeEscuro}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fundo decorativo com gradiente simulado -->
                <BoxView Color="{StaticResource VerdeEscuro}" />

                <!-- Conteúdo do Hero -->
                <VerticalStackLayout 
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="8"
                Padding="30,0">

                    <!-- Linha decorativa -->
                    <BoxView 
                    HeightRequest="1"
                    Color="{StaticResource Dourado}"
                    WidthRequest="60"
                    HorizontalOptions="Center"
                    Margin="0,0,0,8"/>

                    <Label
                    Text="CASSOROVA"
                    FontSize="38"
                    FontAttributes="Bold"
                    TextColor="{StaticResource BrancoQuente}"
                    HorizontalTextAlignment="Center"
                    CharacterSpacing="6"/>

                    <Label
                    Text="HOTEL BOUTIQUE"
                    FontSize="13"
                    TextColor="{StaticResource Dourado}"
                    HorizontalTextAlignment="Center"
                    CharacterSpacing="4"/>

                    <!-- Linha decorativa -->
                    <BoxView 
                    HeightRequest="1"
                    Color="{StaticResource Dourado}"
                    WidthRequest="60"
                    HorizontalOptions="Center"
                    Margin="0,8,0,0"/>

                    <Label
                    Text="Brotas • São Paulo"
                    FontSize="13"
                    TextColor="{StaticResource CremeEscuro}"
                    HorizontalTextAlignment="Center"
                    Margin="0,6,0,0"/>

                </VerticalStackLayout>
            </Grid>

            <!-- TAG LINE -->
            <VerticalStackLayout 
            BackgroundColor="{StaticResource Terracota}"
            Padding="20,14">
                <Label
                Text="Natureza • Exclusividade • Bem-estar"
                FontSize="13"
                TextColor="{StaticResource BrancoQuente}"
                HorizontalTextAlignment="Center"
                CharacterSpacing="1"/>
            </VerticalStackLayout>

            <!-- MENU PRINCIPAL -->
            <VerticalStackLayout Padding="24,28" Spacing="14">

                <Label
                Text="O que deseja fazer?"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{StaticResource TextoSecundario}"
                Margin="0,0,0,6"/>

                <!-- Acomodações -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource CremeEscuro}" StrokeThickness="1">
                    <Grid BackgroundColor="{StaticResource BrancoQuente}" Padding="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ícone -->
                        <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource VerdeMedio}"
                        HeightRequest="46" WidthRequest="46">
                            <Label Text="🏡" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Texto -->
                        <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Acomodações" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
                            <Label Text="Suítes e chalés exclusivos" FontSize="12" TextColor="{StaticResource TextoSecundario}"/>
                        </VerticalStackLayout>

                        <!-- Seta -->
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Terracota}" VerticalOptions="Center"/>

                        <!-- Toque -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrAcomodacoes"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Passeios -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource CremeEscuro}" StrokeThickness="1">
                    <Grid BackgroundColor="{StaticResource BrancoQuente}" Padding="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource VerdeClaro}"
                        HeightRequest="46" WidthRequest="46">
                            <Label Text="🌿" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Passeios" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
                            <Label Text="Trilhas, tirolesa e cachoeiras" FontSize="12" TextColor="{StaticResource TextoSecundario}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Terracota}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrPasseios"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Reservas -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource CremeEscuro}" StrokeThickness="1">
                    <Grid BackgroundColor="{StaticResource BrancoQuente}" Padding="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource Terracota}"
                        HeightRequest="46" WidthRequest="46">
                            <Label Text="📅" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Reservas" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
                            <Label Text="Planeje sua estadia" FontSize="12" TextColor="{StaticResource TextoSecundario}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Terracota}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrReservas"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Pagamentos -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource CremeEscuro}" StrokeThickness="1">
                    <Grid BackgroundColor="{StaticResource BrancoQuente}" Padding="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource Dourado}"
                        HeightRequest="46" WidthRequest="46">
                            <Label Text="💳" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Pagamentos" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
                            <Label Text="Pix, cartão e carteiras digitais" FontSize="12" TextColor="{StaticResource TextoSecundario}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Terracota}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrPagamentos"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Avaliações -->
                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource CremeEscuro}" StrokeThickness="1">
                    <Grid BackgroundColor="{StaticResource BrancoQuente}" Padding="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource TerracotaClaro}"
                        HeightRequest="46" WidthRequest="46">
                            <Label Text="⭐" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="14,0,0,0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Avaliações" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextoPrincipal}"/>
                            <Label Text="O que nossos hóspedes dizem" FontSize="12" TextColor="{StaticResource TextoSecundario}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource Terracota}" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="IrAvaliacoes"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

            </VerticalStackLayout>

            <!-- RODAPÉ -->
            <VerticalStackLayout 
            BackgroundColor="{StaticResource VerdeEscuro}" 
            Padding="24,20"
            Spacing="4">
                <Label 
                Text="Cassorova Hotel Boutique"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="{StaticResource Dourado}"
                HorizontalTextAlignment="Center"/>
                <Label 
                Text="Brotas, São Paulo • (14) 99999-0000"
                FontSize="11"
                TextColor="{StaticResource CremeEscuro}"
                HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
